<Window x:Class="TaxaStation.DriverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaxaStation"
        mc:Ignorable="d"
        Title="Driver" Height="375" Width="500">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/ProgramBackground.png" Stretch="Fill"/>
        </Grid.Background>
        <Label Content="Welcome driver" HorizontalAlignment="Left" Margin="20,49,0,0" VerticalAlignment="Top" FontSize="25"/>
        <Button x:Name="AvailableButton" Content="Available" HorizontalAlignment="Left" Margin="10,97,0,0" VerticalAlignment="Top" Height="111" Width="104" Click="AvailableButton_Click" Background="Green"/>
        <Button x:Name="UnavailableButton" Content="Unavailable" HorizontalAlignment="Left" Margin="119,97,0,0" VerticalAlignment="Top" Height="111" Width="104" Click="UnavilableButton_Click" Background="Red"/>
        <Button x:Name="OnBreakButton" Content="On break" HorizontalAlignment="Left" Margin="10,213,0,0" VerticalAlignment="Top" Height="111" Width="104" Click="OnBreakButton_Click" Background="GhostWhite"/>
        <Button x:Name="NotWorkingButton" Content="Not Working" HorizontalAlignment="Left" Margin="119,213,0,0" VerticalAlignment="Top" Height="111" Width="104" Click="NotWorkingButton_Click" Background="GhostWhite"></Button>
        <Label Content="List of drivers" HorizontalAlignment="Left" Margin="300,49,0,0" VerticalAlignment="Top" FontSize="20"/>
        <Button x:Name="BackButton" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Top" 
        Height="56" 
        Width="223" 
        Click="BackButton_Click"
        Background="Transparent"
        Panel.ZIndex="99"
        BorderThickness="0"
        Cursor="Hand">
            <Image Source="/Images/Background4.png" Height="42" Width="237" />
        </Button>
        <ListBox x:Name="DriverListBoxDriver" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="228,97,0,10" Background="Transparent"/>


    </Grid>
</Window>
