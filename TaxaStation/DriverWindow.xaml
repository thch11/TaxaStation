<Window x:Class="TaxaStation.DriverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaxaStation"
        mc:Ignorable="d"
        Title="Driver" Height="375" Width="500">
    <Grid>
        <Label Content="Welcome" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="45"/>
        <Button x:Name="AvailableButton" Content="Available" HorizontalAlignment="Left" Margin="10,97,0,0" VerticalAlignment="Top" Height="111" Width="104" Click="AvailableButton_Click"/>
        <Button x:Name="UnavailableButton" Content="Unavailable" HorizontalAlignment="Left" Margin="119,97,0,0" VerticalAlignment="Top" Height="111" Width="104" Click="UnavilableButton_Click"/>
        <Button x:Name="OnBreakButton" Content="On break" HorizontalAlignment="Left" Margin="10,213,0,0" VerticalAlignment="Top" Height="111" Width="104" Click="OnBreakButton_Click"/>
        <Button x:Name="NotWorkingButton" Content="Not Working" HorizontalAlignment="Left" Margin="119,213,0,0" VerticalAlignment="Top" Height="111" Width="104" Click="NotWorkingButton_Click"/>
        <Label Content="Drivers" HorizontalAlignment="Left" Margin="283,10,0,0" VerticalAlignment="Top" FontSize="45"/>
        <Button x:Name="BackButton" Content="Back" HorizontalAlignment="Left" Margin="204,22,0,0" VerticalAlignment="Top" Height="45" Width="85" Click="BackButton_Click"/>
        <ListBox x:Name="DriverListBoxDriver" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="228,97,0,10"/>


    </Grid>
</Window>
