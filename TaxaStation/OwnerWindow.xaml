<Window x:Class="TaxaStation.OwnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaxaStation"
        mc:Ignorable="d"
        Title="Owner" Height="380" Width="580">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/ProgramBackground.png" Stretch="Fill"/>
        </Grid.Background>
        <Label Content="List of all drivers:" HorizontalAlignment="Left" Margin="366,23,0,0" VerticalAlignment="Top" FontSize="25"/>
        <Label Content="Name" HorizontalAlignment="Left" Margin="19,53,0,0" VerticalAlignment="Top" Width="65"/>
        <TextBox x:Name="DriverTextBoxInput" HorizontalAlignment="Left" Margin="19,81,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="153" MaxLength="34" Background="Transparent"/>
        <TextBox x:Name="DriverTextBoxInputPassword" HorizontalAlignment="Left" Margin="19,126,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="153" MaxLength="34" Background="Transparent"/>
        <Label Content="Working hours" HorizontalAlignment="Left" Margin="19,149,0,0" VerticalAlignment="Top"/>
        <Label Content="From:" HorizontalAlignment="Left" Margin="19,180,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="WorkingHoursStartTextBoxInput" HorizontalAlignment="Left" Margin="59,184,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="25" MaxLength="2" Background="Transparent"/>
        <Label Content="To:" HorizontalAlignment="Left" Margin="116,180,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="WorkingHoursEndTextBoxInput" HorizontalAlignment="Left" Margin="146,184,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="26" MaxLength="2" Background="Transparent"/>
        <Button x:Name="AddDriverButton" Content="Add Driver" HorizontalAlignment="Left" Margin="19,252,0,0" VerticalAlignment="Top" Width="153" Height="42" FontSize="22" Click="AddDriverButton_Click" Background="Transparent"/>
        <Button x:Name="BackButton" 
  HorizontalAlignment="Left" 
  VerticalAlignment="Top" 
  Height="67" 
  Width="200" 
  Click="BackButton_Click"
  Background="Transparent"
  Panel.ZIndex="99"
  BorderThickness="0"
  Cursor="Hand" Margin="0,-5,0,0">
            <Image Source="/Images/Background4.png" Height="42" Width="237" />
        </Button>
        <ListBox x:Name="DriverListBoxOwner" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="366,81,0,10" Background="Transparent"/>
        <Label Content="Password" HorizontalAlignment="Left" Margin="19,99,0,0" VerticalAlignment="Top" Width="65"/>
        <Button x:Name="RemoveDriverButton" Content="Remove Driver" HorizontalAlignment="Left" Margin="19,299,0,0" VerticalAlignment="Top" Width="153" Height="42" FontSize="22" Click="Remove_Driver_Button_Click" Background="Transparent"/>
        <ComboBox x:Name="CarComboBox" HorizontalAlignment="Left" Margin="21,225,0,0" VerticalAlignment="Top" Width="151" Background="Transparent"/>
        <Label Content="Car:" HorizontalAlignment="Left" Margin="76,199,0,0" VerticalAlignment="Top" Width="52"/>
        <Button x:Name="AddCarButton" Content="Add Car" HorizontalAlignment="Left" Margin="201,258,0,0" VerticalAlignment="Top" Height="83" Width="139" Background="Transparent" FontSize="22" Click="AddCarButton_Click"/>
        <TextBox x:Name="CarTextBoxCarBrand" HorizontalAlignment="Left" Margin="201,99,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Background="Transparent"/>
        <TextBox x:Name="CarTextBoxLicensePlate" HorizontalAlignment="Left" Margin="201,164,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Background="Transparent"/>
        <TextBox x:Name="CarTextBoxKMDriven" HorizontalAlignment="Left" Margin="201,218,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Background="Transparent"/>
        <Label Content="Car brand:" HorizontalAlignment="Left" Margin="201,66,0,0" VerticalAlignment="Top" Width="65"/>
        <Label Content="License Plate:" HorizontalAlignment="Left" Margin="201,131,0,0" VerticalAlignment="Top" Width="98"/>
        <Label Content="KM Driven: " HorizontalAlignment="Left" Margin="201,188,0,0" VerticalAlignment="Top" Width="69"/>


    </Grid>
</Window>
