<Window x:Class="TaxaStation.OwnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaxaStation"
        mc:Ignorable="d"
        Title="Owner" Height="350" Width="480">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/ProgramBackground.png" Stretch="Fill"/>
        </Grid.Background>
        <Label Content="List of all drivers:" HorizontalAlignment="Left" Margin="213,19,0,0" VerticalAlignment="Top" FontSize="25"/>
        <Label Content="Name" HorizontalAlignment="Left" Margin="19,80,0,0" VerticalAlignment="Top" Width="65"/>
        <TextBox x:Name="DriverTextBoxInput" HorizontalAlignment="Left" Margin="19,116,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="178" MaxLength="34"/>
        <Label Content="Working hours" HorizontalAlignment="Left" Margin="19,149,0,0" VerticalAlignment="Top"/>
        <Label Content="From:" HorizontalAlignment="Left" Margin="19,180,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="WorkingHoursStartTextBoxInput" HorizontalAlignment="Left" Margin="59,184,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="51" MaxLength="2"/>
        <Label Content="To:" HorizontalAlignment="Left" Margin="116,180,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="WorkingHoursEndTextBoxInput" HorizontalAlignment="Left" Margin="146,184,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="51" MaxLength="2"/>
        <Button x:Name="AddDriverButton" Content="Add Driver" HorizontalAlignment="Left" Margin="19,216,0,0" VerticalAlignment="Top" Width="181" Height="79" FontSize="32" Click="AddDriverButton_Click"/>
        <Button x:Name="BackButton" 
  HorizontalAlignment="Left" 
  VerticalAlignment="Top" 
  Height="67" 
  Width="200" 
  Click="BackButton_Click"
  Background="Transparent"
  Panel.ZIndex="99"
  BorderThickness="0"
  Cursor="Hand" Margin="0,-5,0,0">
            <Image Source="/Images/Background4.png" Height="42" Width="237" />
        </Button>
        <ListBox x:Name="DriverListBoxOwner" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="205,81,0,10" Background="Transparent"/>

    </Grid>
</Window>
