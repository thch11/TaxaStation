<Window x:Name="Customer" x:Class="TaxaStation.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaxaStation"
        mc:Ignorable="d"
        Title="Customer" Height="250" Width="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="199*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BookTaxiButton" Content="Book Taxi" HorizontalAlignment="Left" Margin="9,63,0,0" VerticalAlignment="Top" Height="78" Width="177" Click="Book_Taxi_Button_Click" Grid.Column="1"/>
        <Label Content="Welcome Customer" HorizontalAlignment="Left" Margin="8,10,0,0" VerticalAlignment="Top" FontSize="21" Grid.Column="1"/>
        <Label Content="Drivers:" HorizontalAlignment="Left" Margin="260,10,0,0" VerticalAlignment="Top" FontSize="21" Grid.Column="1"/>
        <Button x:Name="BackButton" Content="Back" HorizontalAlignment="Left" Height="78" Width="178" VerticalAlignment="Top" Click="BackButton_Click" Margin="8,146,0,0" Grid.Column="1" />
        <ListBox x:Name="DriverListBoxCustomer" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Column="1" Margin="199,63,0,0"/>



    </Grid>
</Window>
